{
  "name": "@bazaro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/instrument.ts src/index.ts",
    "build": "tsc",
    "start": "node --enable-source-maps --import ./dist/instrument.js dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bazaro/monitoring": "workspace:*",
    "@bazaro/shared": "workspace:*",
    "@sentry/node": "catalog:",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@bazaro/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
