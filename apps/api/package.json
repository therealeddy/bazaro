{
  "name": "@bazaro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/instrument.ts src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --import ./dist/instrument.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bazaro/monitoring": "workspace:*",
    "@bazaro/shared": "workspace:*",
    "@sentry/node": "catalog:",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@bazaro/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
