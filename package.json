{
  "name": "bazaro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@bazaro/config": "workspace:*",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/cz-commitlint": "21.2.4",
    "commitizen": "4.3.2",
    "eslint": "catalog:",
    "globals": "catalog:",
    "husky": "9.1.7",
    "inquirer": "12.11.1",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "catalog:"
  }
}
