{
  "name": "@bazaro/monitoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./next/client": {
      "types": "./dist/next/client.d.ts",
      "default": "./dist/next/client.js"
    },
    "./next/server": {
      "types": "./dist/next/server.d.ts",
      "default": "./dist/next/server.js"
    },
    "./next/config": {
      "types": "./dist/next/config.d.ts",
      "default": "./dist/next/config.js"
    },
    "./next/global-error": {
      "types": "./dist/next/global-error.d.ts",
      "default": "./dist/next/global-error.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sentry/nextjs": "catalog:",
    "@sentry/node": "catalog:",
    "@sentry/react": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "next": "catalog:",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@sentry/nextjs": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    },
    "@sentry/react": {
      "optional": true
    },
    "@sentry/vite-plugin": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bazaro/config": "workspace:*",
    "@sentry/nextjs": "catalog:",
    "@sentry/node": "catalog:",
    "@sentry/react": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
